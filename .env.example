# ─────────────────────────────────────────────────────────────
# Annex HR — environment template. Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database (Aiven PostgreSQL) ──────────────────────────────
DB_HOST=your-project.aivencloud.com
DB_PORT=5432
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD="change-me"
# All Annex HR tables live in this schema.
DB_SCHEMA=annex-hr
DB_SSL=true
# Path to Aiven's CA certificate (download "CA certificate" from the Aiven console).
# When set, the TLS certificate is fully verified. When empty, TLS is used without verification.
DB_SSL_CA_PATH=
DB_POOL_MAX=4

# ── API server ───────────────────────────────────────────────
API_PORT=8000
# Public URL of the web app (used in email links).
APP_URL=http://localhost:5173
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=annex_session
COOKIE_SECURE=false

# ── Custom domains ───────────────────────────────────────────
# Host that a customer's custom domain must CNAME to (e.g. hr.company.com → cname.annexhr.com)
# before "Check DNS" marks it verified.
CUSTOM_DOMAIN_TARGET=cname.annexhr.com

# ── Email ────────────────────────────────────────────────────
# Provider order: "auto" tries Resend → Brevo → SMTP. Or set e.g. EMAIL_PROVIDER=brevo,smtp
# With no provider configured, emails are printed to the API console (development).
EMAIL_PROVIDER=auto
EMAIL_FROM_NAME="Annex HR"
EMAIL_FROM_ADDRESS=noreply@your-verified-domain.com
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail: use an App Password (Google Account → Security → App passwords)
SMTP_PASSWORD=

# ── Demo / seed ──────────────────────────────────────────────
# Enables one-click "demo account" sign-in and the "View as" role switcher.
ENABLE_DEMO_LOGIN=true
# Password given to every seeded demo user (e.g. wanjiku.kamau@umba.com).
# Quote values that contain #, otherwise the rest is treated as a comment.
SEED_DEFAULT_PASSWORD="change-me"

# ── Frontend (exposed to the browser — no secrets here) ──────
VITE_API_URL=/api
VITE_APP_DOMAIN=annexhr.com
# true = run the UI entirely on in-browser demo data (no backend needed).
VITE_USE_MOCK_API=false
